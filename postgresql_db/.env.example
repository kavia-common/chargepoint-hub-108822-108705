# PostgreSQL container environment for ChargeMate

# Local Postgres (used by local DB and db_visualizer)
POSTGRES_URL=postgresql://localhost:5000/myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_PORT=5000

# Supabase-managed Postgres (optional if connecting via Supabase)
SUPABASE_DB_URL=postgresql://user:password@host:5432/dbname

# Notes:
# - startup.sh in this folder initializes a local Postgres on PORT=5000 by default.
# - db_visualizer tools will source db_visualizer/postgres.env or values above.
# - The backend_api can use SUPABASE_DB_URL or the local POSTGRES_* values depending on your setup.
